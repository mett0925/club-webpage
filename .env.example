DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=club_web_page
PORT=3000

# 이메일 인증번호 발송용 SMTP 설정
# Gmail을 쓰는 경우 SMTP_USER에는 Gmail 주소, SMTP_PASS에는 앱 비밀번호를 넣으세요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=your_email@gmail.com

