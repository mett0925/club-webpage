DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=club_web_page
PORT=3000

# OAuth 콜백 기준 URL (선택, 미설정 시 접속한 주소/포트를 자동 사용)
# Google 콘솔 Redirect URI는 실제 접속 포트와 같아야 합니다.
# 예: http://localhost:3000/api/auth/google/callback
#     http://localhost:3001/api/auth/google/callback
OAUTH_REDIRECT_BASE=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 이메일 인증번호 발송용 SMTP 설정
# Gmail을 쓰는 경우 SMTP_USER에는 Gmail 주소, SMTP_PASS에는 앱 비밀번호를 넣으세요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=your_email@gmail.com
